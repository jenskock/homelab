# Copy to /opt/paperless/env on the server and replace placeholder values.
# chmod 600 /opt/paperless/.env

# Postgres
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=paperless

# Paperless
PAPERLESS_SECRET_KEY=change-me
PAPERLESS_URL=https://lab-paperless.jenskock.de
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=paperless
PAPERLESS_DBNAME=paperless
PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_OCR_LANGUAGE=deu+eng

# Optional: create admin on first run
# PAPERLESS_ADMIN_USER=admin
# PAPERLESS_ADMIN_PASSWORD=change-me
