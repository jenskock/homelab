# ==== OpenWebUI ====
ENABLE_PERSISTENT_CONFIG=false
WEBUI_SECRET_KEY=change-me
JWT_EXPIRES_IN=4w
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
ENABLE_OAUTH_SIGNUP=true
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=false
ENABLE_OPENAI_API=true
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=true
ENABLE_OLLAMA_API=false
ENABLE_DIRECT_CONNECTIONS=true
CONTENT_EXTRACTION_ENGINE=tika
BYPASS_EMBEDDING_AND_RETRIEVAL=true
ENABLE_FORWARD_USER_INFO_HEADERS=true
ENABLE_EVALUATION_ARENA_MODELS=false
ENABLE_COMMUNITY_SHARING=false
#DEFAULT_USER_ROLE=user
#DEFAULT_GROUP_ID=create-default-group-and-add-uuid-here

# ==== OpenWebUI - Web Search ====
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://searxng:8080/search
WEB_SEARCH_RESULT_COUNT=5
WEB_SEARCH_CONCURRENT_REQUESTS=1
BYPASS_WEB_SEARCH_WEB_LOADER=true
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=true

# ==== OpenWebUI - Image Generation ====
ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATION_ENGINE=openai
IMAGE_GENERATION_MODEL=azure/openai/gpt-image-2
IMAGE_SIZE=1024x1024
IMAGES_OPENAI_API_BASE_URL=https://router.requesty.ai/v1
IMAGES_OPENAI_API_KEY=

# ==== OpenWebUI - Image Edit ====
ENABLE_IMAGE_EDIT=true
IMAGE_EDIT_ENGINE=openai
IMAGE_EDIT_MODEL=azure/openai/gpt-image-2
IMAGE_EDIT_SIZE=1024x1024
IMAGES_EDIT_OPENAI_API_BASE_URL=https://router.requesty.ai/v1
IMAGES_EDIT_OPENAI_API_KEY=

# ==== OpenWebUI - Audio STT ====
AUDIO_STT_ENGINE=openai
AUDIO_STT_MODEL=mistral/voxtral-mini-latest
AUDIO_STT_OPENAI_API_BASE_URL=https://router.requesty.ai/v1
AUDIO_STT_OPENAI_API_KEY=

# ==== OpenWebUI - TTS ====
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_MODEL=openai/tts-1
AUDIO_TTS_OPENAI_API_BASE_URL=https://router.requesty.ai/v1
AUDIO_TTS_OPENAI_API_KEY=

# ==== OpenWebUI - OpenAI ====
OPENAI_API_BASE_URL=https://router.requesty.ai/v1
OPENAI_API_KEY=